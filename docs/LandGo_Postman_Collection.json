{
	"info": {
		"_postman_id": "landgo-api-collection-v1",
		"name": "LandGo Backend API",
		"description": "Complete API collection for LandGo land listing platform.\n\n## Setup Instructions\n1. Import this collection into Postman\n2. Create an environment called 'LandGo Local'\n3. Add variable: `BASE_URL` = `http://localhost:8080`\n4. Run requests in order: Register → Login → Subscribe → Vendor Register → Re-Login → Create Land\n\n## Important Notes\n- After vendor registration, you MUST re-login to get a token with VENDOR role\n- New land listings are created with status PENDING_APPROVAL\n- Only ACTIVE lands appear in public browse endpoints",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "BASE_URL",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "TOKEN",
			"value": "",
			"type": "string"
		},
		{
			"key": "LAND_ID",
			"value": "",
			"type": "string"
		},
		{
			"key": "VENDOR_ID",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "🏥 Health Check",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{BASE_URL}}/actuator/health",
							"host": ["{{BASE_URL}}"],
							"path": ["actuator", "health"]
						},
						"description": "Check if the application is running and healthy."
					},
					"response": []
				}
			]
		},
		{
			"name": "🔐 Authentication",
			"item": [
				{
					"name": "1. Register User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();",
									"if (response.success && response.data && response.data.accessToken) {",
									"    pm.collectionVariables.set('TOKEN', response.data.accessToken);",
									"    console.log('✅ Token saved to collection variable');",
									"}",
									"",
									"pm.test('Status code is 201', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('Response has access token', function () {",
									"    pm.expect(response.data.accessToken).to.not.be.empty;",
									"});",
									"",
									"pm.test('User role is USER', function () {",
									"    pm.expect(response.data.user.role).to.eql('USER');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"1234567890\"\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/v1/auth/register",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "v1", "auth", "register"]
						},
						"description": "Register a new user with email and password. The access token is automatically saved for subsequent requests."
					},
					"response": []
				},
